{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://briefwright.dev/schemas/briefing.v1.schema.json",
  "title": "Briefwright briefing intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "interests"],
  "properties": {
    "version": {
      "enum": [1, 2]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "preset": {
      "type": "string",
      "enum": ["ai-daily"],
      "default": "ai-daily"
    },
    "interests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "schedule": {
      "type": "string",
      "enum": ["manual", "daily-at-10", "weekdays-at-09"],
      "default": "manual"
    },
    "output": {
      "type": "string",
      "enum": ["markdown"],
      "default": "markdown"
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1,
      "default": "briefs"
    },
    "ai": {
      "type": "string",
      "enum": ["qwen"],
      "default": "qwen"
    }
  }
}
