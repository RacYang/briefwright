{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://briefwright.dev/schemas/briefing.v3.schema.json",
  "title": "Briefwright briefing intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "interests"],
  "properties": {
    "version": {
      "enum": [1, 2, 3]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "preset": {
      "type": "string",
      "enum": ["ai-daily"],
      "default": "ai-daily"
    },
    "interests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "schedule": {
      "type": "string",
      "enum": ["manual", "daily-at-10", "weekdays-at-09"],
      "default": "manual"
    },
    "output": {
      "type": "string",
      "enum": ["markdown"],
      "default": "markdown"
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1,
      "default": "briefs"
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "ai": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "model": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider"],
          "properties": {
            "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "protocol": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "model": { "type": "string", "minLength": 1, "maxLength": 160 },
            "reasoningEffort": { "enum": ["low", "medium", "high", "xhigh"] },
            "baseUrl": { "type": "string", "format": "uri" },
            "apiKey": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "key"],
              "properties": {
                "provider": { "enum": ["env", "file"] },
                "key": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            },
            "allowedHosts": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Za-z0-9.:-]+$" }
            },
            "allowInsecureLocalhost": { "type": "boolean" }
          }
        }
      ],
      "default": "ollama"
    },
    "processStore": {
      "oneOf": [
        { "enum": ["auto", "sqlite"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver"],
          "properties": {
            "driver": { "enum": ["lark", "postgres", "mysql", "sqlite"] },
            "baseToken": { "type": "string", "minLength": 1, "maxLength": 200 },
            "profile": { "type": "string", "minLength": 1, "maxLength": 120 },
            "identity": { "enum": ["user", "bot"] },
            "xCapture": { "enum": ["api", "codex-browser"] },
            "maximumRecordsPerTable": { "type": "integer", "minimum": 100, "maximum": 10000000 },
            "tables": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "sources": { "type": "string" }, "runs": { "type": "string" },
                "items": { "type": "string" }, "events": { "type": "string" },
                "feedback": { "type": "string" }, "experiments": { "type": "string" },
                "captures": { "type": "string" }, "rules": { "type": "string" },
                "receipts": { "type": "string" }
              }
            },
            "connection": {
              "type": "object", "additionalProperties": false, "required": ["provider", "key"],
              "properties": {
                "provider": { "enum": ["env", "file"] },
                "key": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          }
        }
      ],
      "default": "auto"
    },
    "documentStore": {
      "oneOf": [
        { "enum": ["auto", "local", "obsidian"] },
        {
          "type": "object", "additionalProperties": false, "required": ["driver"],
          "properties": {
            "driver": { "enum": ["local", "obsidian"] },
            "root": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "briefingDirectory": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      ],
      "default": "auto"
    }
  }
}
