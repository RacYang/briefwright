{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://briefwright.dev/schemas/preset.v1.schema.json",
  "title": "Briefwright preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "description", "quality", "coverage", "cost", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "quality": { "enum": ["strict", "balanced"] },
    "coverage": { "enum": ["focused", "balanced", "broad"] },
    "cost": { "enum": ["low", "moderate", "high"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "connector"],
        "properties": {
          "id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "cadence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimumHours", "defaultHours", "maximumHours"],
            "properties": {
              "minimumHours": { "type": "number", "exclusiveMinimum": 0 },
              "defaultHours": { "type": "number", "exclusiveMinimum": 0 },
              "maximumHours": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "connector": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "config"],
                "properties": {
                  "type": { "const": "github-releases" },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["repository"],
                    "properties": { "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" } }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "config"],
                "properties": {
                  "type": { "const": "rss" },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url"],
                    "properties": { "url": { "type": "string", "format": "uri", "pattern": "^https://" } }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "config"],
                "properties": {
                  "type": { "const": "extension" },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["adapter", "options"],
                    "properties": {
                      "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                      "options": { "type": "object" }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
