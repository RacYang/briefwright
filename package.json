{
  "name": "briefwright",
  "version": "2.0.1",
  "description": "Auditable, human-in-the-loop intelligence briefings from sources to knowledge.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "briefwright": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connector-sdk": {
      "types": "./dist/connector-sdk.d.ts",
      "import": "./dist/connector-sdk.js"
    }
  },
  "files": [
    "dist",
    "presets",
    "policies",
    "prompts",
    "providers",
    "protocol",
    "schemas",
    "templates",
    "skill",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "check": "pnpm run typecheck && pnpm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --testTimeout=20000",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "package:smoke": "node scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.16.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RacYang/briefwright.git"
  },
  "bugs": {
    "url": "https://github.com/RacYang/briefwright/issues"
  },
  "homepage": "https://github.com/RacYang/briefwright#readme",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.0",
    "fast-xml-parser": "^5.10.1",
    "ipaddr.js": "^2.5.0",
    "mysql2": "^3.23.2",
    "pg": "^8.23.0",
    "undici": "^8.10.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
